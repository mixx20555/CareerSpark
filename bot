CREATE TABLE IF NOT EXISTS users (
    user_id     INTEGER PRIMARY KEY,          -- telegram user id
    username    TEXT,
    age_group   TEXT,                         -- teen / adult / unknown
    fatigue     TEXT,                         -- burnout: none / tired / burned_out
    interests   TEXT DEFAULT '[]',            -- JSON-список тегов
    created_at  INTEGER,
    updated_at  INTEGER
);

CREATE TABLE IF NOT EXISTS directions (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    title        TEXT NOT NULL,               -- название направления
    emoji        TEXT DEFAULT '',             -- иконка для красивого вывода
    description  TEXT NOT NULL,               -- короткое «зачем это»
    tags         TEXT NOT NULL,               -- теги через запятую: it,creative...
    audience     TEXT DEFAULT 'all',          -- teen / adult / all
    fatigue_fit  INTEGER DEFAULT 0,           -- 0..3: насколько подходит выгоревшим
    how_to_start TEXT,                        -- первые 3 шага
    salary_range TEXT,                        -- ориентир по доходу (можно пусто)
    resources    TEXT                         -- курсы/ссылки через ' | '
);

CREATE TABLE IF NOT EXISTS suggestions (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id     INTEGER,
    text        TEXT NOT NULL,                -- идея пользователя для базы
    processed   INTEGER DEFAULT 0,            -- 0 = новая, 1 = добавлена в базу
    created_at  INTEGER
);
"""


def db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn



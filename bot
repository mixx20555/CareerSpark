                 "аналитика", "игры", "психология", "бизнес", "помощь"]


def seed_db():
    with db() as conn:
        conn.executescript(SCHEMA)
        if conn.execute("SELECT COUNT(*) FROM directions").fetchone()[0] == 0:
            conn.executemany(
                "INSERT INTO directions (title, emoji, description, tags, audience, fatigue_fit,"
                " how_to_start, salary_range, resources) VALUES (?,?,?,?,?,?,?,?,?)",
                SEED_DIRECTIONS,
            )


# ----------------------------------------------------------------------
# 2. Персонализация: подбор направлений
# ----------------------------------------------------------------------

def recommend_for(user: dict, limit: int = 3) -> list:
    """Скоринг: совпадения интересов + аудитория + усталость."""
    interests = set(user.get("interests") or [])
    rows = db().execute("SELECT * FROM directions").fetchall()
    scored = []
    for r in rows:
        tags = {t.strip().lower() for t in r["tags"].split(",")}
        score = len(interests & tags) * 10
        if user.get("age_group") == "teen" and r["audience"] == "adult":
            score -= 5
        if user.get("fatigue") in ("tired", "burned_out"):
            score += r["fatigue_fit"] * 4
        scored.append((score, r))
    scored.sort(key=lambda x: -x[0])
    return [r for _, r in scored[:limit]]


def format_direction(r) -> str:
    return (
        f"{r['emoji']} <b>{r['title']}</b>\n"
        f"{r['description']}\n"
        f"🚀 <b>С чего начать:</b> {r['how_to_start']}\n"
        f"💰 <b>Ориентир по доходу:</b> {r['salary_range']}\n"
        f"📚 <b>Ресурсы:</b> {r['resources']}"
    )


def interests_keyboard(selected: set) -> InlineKeyboardMarkup:
    rows = []
    for tag in INTEREST_TAGS:
        mark = "✅ " if tag in selected else "▫️ "
        rows.append([InlineKeyboardButton(
            text=f"{mark}{tag}",
            callback_data=f"int:{tag}",
        )])
    rows.append([InlineKeyboardButton(text="Готово ✔️", callback_data="int:done")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


# ----------------------------------------------------------------------
# 3. Состояния анкеты (FSM)
# ----------------------------------------------------------------------

class Quiz(StatesGroup):
    age = State()
    interests = State()
    fatigue = State()


# ----------------------------------------------------------------------
# 4. Меню и хендлеры
# ----------------------------------------------------------------------

def main_menu() -> ReplyKeyboardMarkup:
    return ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="🎯 Мой профиль"), KeyboardButton(text="🔮 Подобрать направление")],
            [KeyboardButton(text="📚 Все направления"), KeyboardButton(text="💡 Предложить идею")],
            [KeyboardButton(text="❓ Помощь")],
        ],
        resize_keyboard=True,
    )


async def upsert_user(user_id: int, username: str | None, **fields):
    now = int(time.time())
    with db() as conn:
        if not conn.execute("SELECT 1 FROM users WHERE user_id=?", (user_id,)).fetchone():
            conn.execute("INSERT INTO users (user_id, username, created_at) VALUES (?,?,?)",
                         (user_id, username, now))
        for k, v in fields.items():
            conn.execute(f"UPDATE users SET {k}=?, updated_at=? WHERE user_id=?",
                         (v, now, user_id))


def get_user(user_id: int) -> dict:
    row = db().execute("SELECT * FROM users WHERE user_id=?", (user_id,)).fetchone()
    if not row:
        return {}
    u = dict(row)
    u["interests"] = set(json.loads(u.get("interests") or "[]"))
    return u



@router.message(CommandStart())
async def start(message: Message, state: FSMContext):
    await state.clear()
    await upsert_user(message.from_user.id, message.from_user.username)
    await message.answer(
        "Привет! Я CareerSpark ✨\n"
        "Помогаю подросткам и уставшим от работы взрослым найти дело по душе.\n\n"
        "Выберите кнопку внизу или напишите запрос текстом, например: "
        "«хочу творчество», «интересуют игры и IT», «устал от офиса, что дальше?»",
        reply_markup=main_menu(),
    )



# --- Анкета -------------------------------------------------------------

@router.message(F.text == "🎯 Мой профиль")
async def profile_start(message: Message, state: FSMContext):
    await state.set_state(Quiz.age)
    await message.answer(
        "Начнём анкету! Первый вопрос:\n\n<b>Сколько вам лет?</b>\n(подросток / взрослый / предпочитаю не говорить)",
        reply_markup=ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="Подросток"), KeyboardButton(text="Взрослый"),
                       KeyboardButton(text="Пропустить")]],
            resize_keyboard=True,
        ),
    )


@router.message(Quiz.age)
async def profile_age(message: Message, state: FSMContext):
    mapping = {"подросток": "teen", "взрослый": "adult", "пропустить": "unknown"}
    await upsert_user(message.from_user.id, message.from_user.username,
                      age_group=mapping.get(message.text.lower(), "unknown"))
    await state.set_state(Quiz.interests)
    await message.answer(
        "Отметьте, что вам интересно (можно несколько):",
        reply_markup=interests_keyboard(set()),
    )


@router.callback_query(Quiz.interests, F.data.startswith("int:"))
async def profile_interests(call: CallbackQuery, state: FSMContext):
    tag = call.data[4:]
    data = await state.get_data()
    selected = set(data.get("interests", []))
    if tag == "done":
        await upsert_user(call.from_user.id, call.from_user.username,
                          interests=json.dumps(sorted(selected), ensure_ascii=False))
        await state.set_state(Quiz.fatigue)
        await call.message.answer(
            "Принято! Последний вопрос:\n\n<b>Как вы относитесь к своей текущей работе/учёбе?</b>",
            reply_markup=ReplyKeyboardMarkup(
                keyboard=[[KeyboardButton(text="Всё ок"), KeyboardButton(text="Подустал(а)"),
                           KeyboardButton(text="Выгорание 🔥"), KeyboardButton(text="Пропустить")]],
                resize_keyboard=True,
            ),
        )
        await call.answer()
        return
    selected ^= {tag}
    await state.update_data(interests=sorted(selected))
    await call.message.edit_reply_markup(reply_markup=interests_keyboard(selected))
    await call.answer()


@router.message(Quiz.fatigue)
async def profile_fatigue(message: Message, state: FSMContext):
    mapping = {"всё ок": "none", "подустал(а)": "tired", "выгорание 🔥": "burned_out", "пропустить": "none"}
    await upsert_user(message.from_user.id, message.from_user.username,
                      fatigue=mapping.get(message.text.lower(), "none"))
    await state.clear()
    user = get_user(message.from_user.id)
    recs = recommend_for(user)
    text = "Готово! Профиль сохранён 💾\n\nВаши персональные рекомендации:\n\n" + "\n\n———\n\n".join(
        format_direction(r) for r in recs)
    await message.answer(text, reply_markup=main_menu())



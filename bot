@router.message(F.text == "🔮 Подобрать направление")
async def recommend_btn(message: Message):
    user = get_user(message.from_user.id)
    if not user.get("interests"):
        await message.answer("Сначала заполните анкету: нажмите «🎯 Мой профиль».")
        return
    recs = recommend_for(user)
    await message.answer("Вот что подходит вам больше всего:\n\n" + "\n\n———\n\n".join(
        format_direction(r) for r in recs))


@router.message(F.text == "📚 Все направления")
async def all_directions(message: Message):
    rows = db().execute("SELECT emoji, title, description FROM directions ORDER BY title").fetchall()
    await message.answer("📚 <b>Каталог направлений:</b>\n\n" + "\n".join(
        f"{r['emoji']} <b>{r['title']}</b> — {r['description']}" for r in rows))


@router.message(F.text == "💡 Предложить идею")
async def idea_start(message: Message, state: FSMContext):
    await state.set_state(Suggestion.waiting)
    await message.answer("Напишите в свободной форме, какое направление или ресурс стоит добавить в базу.")


class Suggestion(StatesGroup):
    waiting = State()


@router.message(Suggestion.waiting)
async def idea_save(message: Message, state: FSMContext):
    with db() as conn:
        conn.execute("INSERT INTO suggestions (user_id, text, created_at) VALUES (?,?,?)",
                     (message.from_user.id, message.text, int(time.time())))
    await state.clear()
    await message.answer("Спасибо! Идея сохранена, админы её рассмотрят 💡", reply_markup=main_menu())


# --- Свободный текст: поиск по тегам --------------------------------------

@router.message(F.text)
async def free_text_search(message: Message):
    if message.text == "❓ Помощь":
        await help_cmd(message)
        return
    words = [w.strip(",.?!").lower() for w in message.text.split() if len(w) > 2]
    rows = db().execute("SELECT * FROM directions").fetchall()
    scored = []
    for r in rows:
        haystack = (r["title"] + " " + r["description"] + " " + r["tags"]).lower()
        hits = sum(1 for w in words if w in haystack)
        if hits:
            scored.append((hits, r))
    if not scored:
        await message.answer(
            "Не нашёл совпадений 🤔 Попробуйте другое слово или выберите «📚 Все направления».\n"
            "А если вашего направления нет — «💡 Предложить идею»!")
        return
    scored.sort(key=lambda x: -x[0])
    await message.answer("Нашёл вот это 👇\n\n" + "\n\n———\n\n".join(
        format_direction(r) for _, r in scored[:3]))


# ----------------------------------------------------------------------
# 5. Запуск
# ----------------------------------------------------------------------

async def main():
    logging.basicConfig(level=logging.INFO)
    seed_db()
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    dp = Dispatcher()
    dp.include_router(router)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
